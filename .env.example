# Copy this file to .env and fill in the values. Never commit .env.
# Where to find each value: SETUP.md, steps 2 to 4.

# --- Elastic Cloud ----------------------------------------------------------
# Kibana URL of your Observability project or deployment (no trailing slash).
KIBANA_URL=
# Elasticsearch URL (used only by preflight.sh and reset.sh for data checks).
ELASTICSEARCH_URL=
# API key for the Kibana and Elasticsearch APIs (the "encoded" value).
ELASTIC_API_KEY=
# Kibana space. Leave empty for the default space.
KIBANA_SPACE=

# --- OpenTelemetry ingest (Managed OTLP endpoint) -----------------------------
# From Add data > Applications > OpenTelemetry.
ELASTIC_OTLP_ENDPOINT=
ELASTIC_OTLP_API_KEY=

# --- Alert target -----------------------------------------------------------
# slack, teams, or serverlog (dry run: writes alerts to the Kibana server log).
ALERT_CHANNEL=slack
# Slack incoming webhook URL for the #shop-alerts channel.
SLACK_WEBHOOK_URL=
# Only for ALERT_CHANNEL=teams: webhook URL from the Teams Workflows app.
TEAMS_WEBHOOK_URL=

# --- Demo behaviour ---------------------------------------------------------
# Folder of the cloned github.com/elastic/opentelemetry-demo (created by start-demo.sh).
DEMO_DIR=opentelemetry-demo
# Git ref of the demo to use. Pin a commit after your first good rehearsal.
DEMO_GIT_REF=main
# Simulated shoppers. More shoppers = more checkouts and more laptop load.
DEMO_LOCUST_USERS=10
# The failure that break.sh switches on, and its variant.
DEMO_FLAG=productCatalogLockContention
DEMO_FLAG_VARIANT=on
# Alert when the shop frontend p95 latency is above this value (milliseconds).
LATENCY_THRESHOLD_MS=1000

# --- Business assumptions shown on the dashboard (assumptions, not measured) --
ASSUMED_AVG_ORDER_VALUE_CHF=85
# Completed checkouts per minute when healthy. Measure it in rehearsal
# (dashboard tile "Completed checkouts") and write the value here.
BASELINE_ORDERS_PER_MIN=3
